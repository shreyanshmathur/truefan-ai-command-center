# Port the reminder service listens on (the app points here).
PORT=4300

# Daily reminder schedule (standard cron). Default: 9:00 every day.
REMINDER_CRON=0 9 * * *

# WhatsApp session name (a folder is created to persist the login).
WA_SESSION=truefan

# Optional shared secret. If set, the app must send it as the x-api-key header.
# REMINDER_API_KEY=change-me
